#!/usr/bin/env bash
# XJTLU OWA 邮件 CLI 入口：自动准备 .venv 并转调 owa_cli.py。
# 用法：scripts/owa <子命令> [参数...]   （见 scripts/owa --help）
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$SKILL_DIR/.venv"
PY="$VENV/bin/python"

if [ ! -x "$PY" ]; then
  echo "[owa] 首次运行：创建虚拟环境并安装依赖..." >&2
  python3 -m venv "$VENV"
  "$PY" -m pip install --quiet --upgrade pip >&2
  "$PY" -m pip install --quiet -r "$SKILL_DIR/requirements.txt" >&2
fi

exec "$PY" "$SKILL_DIR/scripts/owa_cli.py" "$@"

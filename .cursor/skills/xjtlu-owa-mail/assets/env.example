# XJTLU UIM 登录凭证
# 复制此文件为 .env 并填入真实值：cp .env.example .env

# UIM 用户名（不含 @student.xjtlu.edu.cn 后缀）
XJTLU_USERNAME=Yourname.Lastname25

# UIM 登录密码
XJTLU_PASSWORD=your_password_here

# 二次验证 (MFA) 的 OTP 地址，otpauth:// 开头
# 形如：otpauth://totp/XJTLU:user?secret=XXXX&issuer=XJTLU
XJTLU_OTP_URL=otpauth://totp/XJTLU:you?secret=YOUR_TOTP_SECRET&issuer=XJTLU
